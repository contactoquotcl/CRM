# --- Producción (Render) ---
NODE_ENV=production
DATABASE_URL=postgres://usuario:clave@host:5432/quot_crm   # Render lo inyecta desde la base de datos
JWT_SECRET=pon-aqui-una-cadena-larga-y-aleatoria
ADMIN_EMAIL=tu-correo@quot.cl          # se usa SOLO para crear el primer admin si no hay usuarios
ADMIN_PASSWORD=una-clave-segura-de-8+  # cambiarla luego desde la app
ADMIN_NAME=Seba
CORS_ORIGIN=https://tu-crm.vercel.app  # URL(s) del frontend, separadas por coma

# --- Desarrollo local ---
# Sin DATABASE_URL el backend usa un Postgres embebido (PGlite) en ./data/pglite
# y crea admin@quot.cl / cambiar123 automáticamente.
