# --- Producción (Render) ---
NODE_ENV=production
DATABASE_URL=postgres://usuario:clave@host:5432/quot_crm   # Render lo inyecta desde la base de datos
JWT_SECRET=pon-aqui-una-cadena-larga-y-aleatoria
ADMIN_EMAIL=tu-correo@quot.cl          # se usa SOLO para crear el primer admin si no hay usuarios
ADMIN_PASSWORD=una-clave-segura-de-8+  # cambiarla luego desde la app
ADMIN_NAME=Seba
CORS_ORIGIN=https://tu-crm.vercel.app  # URL(s) del frontend, separadas por coma

# --- Desarrollo local ---
# Sin DATABASE_URL el backend usa un Postgres embebido (PGlite) en ./data/pglite
# y crea admin@quot.cl / cambiar123 automáticamente.

# --- Chatbot + WooCommerce + Chatwoot (Fase 1) ---
# Los valores reales se cargan SOLO en Render (Environment). Nunca los subas al repositorio.
ANTHROPIC_API_KEY=                      # clave de la API de Claude (console.anthropic.com)
CHATBOT_MODEL=claude-sonnet-5-5         # opcional
CHATBOT_ALLOWED_ORIGINS=https://quot.cl,https://www.quot.cl   # CORS del endpoint público del bot
CHATBOT_TOKEN_SECRET=                   # opcional: si falta se deriva de JWT_SECRET
CRM_PUBLIC_URL=https://tu-crm.vercel.app   # link al CRM dentro de las notas de derivación

WC_BASE_URL=https://quot.cl             # tienda WooCommerce (sin / final)
WC_CONSUMER_KEY=ck_xxx                  # clave REST de SOLO LECTURA
WC_CONSUMER_SECRET=cs_xxx
WC_WEBHOOK_SECRET=                      # el mismo "Secreto" que pongas en los webhooks de WooCommerce
WC_PRICES_INCLUDE_TAX=false             # true si los precios de la tienda ya incluyen IVA
CATALOG_RECONCILE_HOURS=24

CHATWOOT_BASE_URL=https://app.chatwoot.com   # o la URL de tu instancia propia
CHATWOOT_ACCOUNT_ID=1
CHATWOOT_API_TOKEN=                     # token de acceso de un agente administrador (solo backend)
CHATWOOT_INBOX_ID=                      # inbox tipo "API" del sitio web
CHATWOOT_WEBHOOK_SECRET=                # secreto compartido (firma HMAC o ?token= en la URL del webhook)

# Reglas del bot (opcionales; valores por defecto entre paréntesis)
# BOT_MAX_FAILS (2) · BOT_QUOTE_VALIDITY_DAYS (30) · BOT_DELIVERY_TEXT · BOT_SHIPPING_TEXT · BOT_MIN_ORDER_CLP (0)
# BOT_RATE_IP_PER_MIN (40) · BOT_RATE_SESSION_PER_MIN (12) · BOT_SESSIONS_PER_IP_HOUR (20) · BOT_MAX_USER_MESSAGES (80)
# CHATBOT_HANDOFF_LEAD_STATE (nombre del estado del pipeline para leads nacidos de una derivación; por defecto el inicial)
